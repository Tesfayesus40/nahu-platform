# Server
PORT=3000
NODE_ENV=development

# Database (points at the identity schema created by database/migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nahu_platform?schema=identity"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
OTP_EXPIRES_MINUTES=10
# Staging-only: enable test OTP 123456 when SMS is not configured
# OTP_DEV_BYPASS=true

# Africa's Talking (SMS OTP delivery)
# Leave AT_API_KEY / AT_USERNAME unset in local dev — the DEV_OTP fallback
# (123456) works without them. Required once NODE_ENV=production.
AT_API_KEY=
AT_USERNAME=
# Only set once a real Sender ID has been registered and approved with AT.
AT_SENDER_ID=

# Admin portal MFA (required when NODE_ENV=production)
# Generate: openssl rand -hex 32
ADMIN_MFA_ENCRYPTION_KEY=

# Advisory module (AI-powered farmer advice, Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# CORS — required in production (comma-separated origins)
# CORS_ORIGINS=https://your-admin.example.com,https://admin-staging.example.com
# CORS_ORIGINS=

# Public URL used in uploaded photo links (no trailing slash)
PUBLIC_API_URL=http://localhost:3000

# Local directory for listing photos (use a Railway volume in staging/prod)
UPLOAD_DIR=uploads

# --- Production checklist (must set when NODE_ENV=production) ---
# JWT_SECRET              strong random (not the change-me defaults)
# ADMIN_MFA_ENCRYPTION_KEY  openssl rand -hex 32
# CORS_ORIGINS            admin web origin(s)
# DATABASE_URL            staging/prod Postgres
# AT_API_KEY / AT_USERNAME  unless OTP_DEV_BYPASS is intentionally used on staging only
