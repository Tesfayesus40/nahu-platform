// Nahu Platform — Prisma schema for the Identity module
// This maps 1:1 onto database/migrations/001..009_identity_*.sql
// Do not run `prisma migrate dev` against a database that already has these
// tables created by the raw SQL migrations — use `prisma db pull` to confirm
// drift, or `prisma migrate resolve` to mark them as applied.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "catalog", "marketplace", "orders", "farms", "inventory", "warehouse", "audit", "ops", "delivery", "pricing", "payments"]
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED

  @@schema("identity")
  @@map("user_status")
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName          String?   @map("first_name") @db.VarChar(100)
  middleName         String?   @map("middle_name") @db.VarChar(100)
  lastName           String?   @map("last_name") @db.VarChar(100)
  phone              String    @unique @db.VarChar(25)
  email              String?   @unique @db.VarChar(255)
  preferredLanguage  String    @default("en") @map("preferred_language") @db.Char(2)
  status             UserStatus @default(PENDING)
  phoneVerified      Boolean   @default(false) @map("phone_verified")
  emailVerified      Boolean   @default(false) @map("email_verified")
  authzVersion       Int       @default(1) @map("authz_version")
  mustResetPassword  Boolean   @default(false) @map("must_reset_password")
  mfaRequired        Boolean   @default(false) @map("mfa_required")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  credential         Credential?
  userRoles          UserRole[]
  userOrganizations  UserOrganization[]
  rolesAssigned      UserRole[]        @relation("AssignedByUser")
  permissionsGranted RolePermission[] @relation("GrantedByUser")
  farmerProfile      FarmerProfile?
  sellerParties      SellerParty[]
  buyerOrders        Order[]           @relation("BuyerOrders")
  buyerAddresses     BuyerAddress[]
  adminInvitationsReceived AdminInvitation[] @relation("InvitationInvitee")
  adminInvitationsSent     AdminInvitation[] @relation("InvitationInviter")
  mfaFactors         MfaFactor[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  adminSessions      AdminSession[]

  @@map("users")
  @@schema("identity")
}

model Credential {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  passwordHash         String?   @map("password_hash")
  passwordChangedAt    DateTime? @map("password_changed_at") @db.Timestamptz
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
  @@schema("identity")
}

model Role {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(50)
  displayName      String   @map("display_name") @db.VarChar(100)
  description      String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(100)
  displayName      String   @map("display_name") @db.VarChar(150)
  description      String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  rolePermissions  RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy  String?  @map("assigned_by") @db.Uuid

  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser  User? @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionId  String   @map("permission_id") @db.Uuid
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy     String?  @map("granted_by") @db.Uuid

  role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser   User?       @relation("GrantedByUser", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model Organization {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique @db.VarChar(50)
  name               String    @db.VarChar(255)
  description        String?
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  userOrganizations  UserOrganization[]

  @@map("organizations")
  @@schema("identity")
}

model UserOrganization {
  userId          String   @map("user_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  positionTitle   String?  @map("position_title") @db.VarChar(100)
  joinedAt        DateTime @default(now()) @map("joined_at") @db.Timestamptz
  isPrimary       Boolean  @default(false) @map("is_primary")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("user_organizations")
  @@schema("identity")
}

model OtpCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @db.VarChar(25)
  code       String   @db.VarChar(6)
  used       Boolean  @default(false)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone])
  @@map("otp_codes")
  @@schema("identity")
}

model AdminInvitation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(25)
  invitedUserId String?   @map("invited_user_id") @db.Uuid
  roleCodes     String[]  @map("role_codes")
  tokenHash     String    @unique @map("token_hash")
  invitedBy     String    @map("invited_by") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invitedUser   User?     @relation("InvitationInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedByUser User      @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([email])
  @@map("admin_invitations")
  @@schema("identity")
}

// MFA type is VARCHAR + CHECK in identity/015 (not a Postgres enum).
// Keep as String so Prisma does not cast to a missing identity.mfa_factor_type.
model MfaFactor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String    @default("TOTP") @db.VarChar(20)
  label           String?   @db.VarChar(100)
  secretEncrypted String    @map("secret_encrypted")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
  @@schema("identity")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

model AdminSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash")
  authzVersionAtIssue Int       @map("authz_version_at_issue")
  ip                  String?   @db.VarChar(64)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason        String?   @map("revoke_reason") @db.VarChar(100)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  reauthenticatedAt   DateTime? @map("reauthenticated_at") @db.Timestamptz

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          AdminSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            AdminSession[] @relation("SessionReplacement")

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("admin_sessions")
  @@schema("identity")
}

// Outcome is VARCHAR + CHECK in audit/002 (not a Postgres enum).
// Keep as String so Prisma does not cast to a missing audit.audit_outcome.
model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorSessionId String?  @map("actor_session_id") @db.Uuid
  permissionCode String?  @map("permission_code") @db.VarChar(100)
  action         String   @db.VarChar(100)
  targetType     String?  @map("target_type") @db.VarChar(100)
  targetId       String?  @map("target_id") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(100)
  reason         String?
  outcome        String   @db.VarChar(20)
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  metadataJson   Json?    @map("metadata_json")

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([action])
  @@map("events")
  @@schema("audit")
}

model FeatureFlag {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(100)
  displayName     String    @map("display_name") @db.VarChar(200)
  description     String?
  enabled         Boolean   @default(false)
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([enabled])
  @@map("feature_flags")
  @@schema("ops")
}

model ReportJob {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportType         String    @map("report_type") @db.VarChar(80)
  status             String    @default("PENDING") @db.VarChar(20)
  filtersJson        Json?     @map("filters_json")
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  rowCount           Int?      @map("row_count")
  artifactCsv        String?   @map("artifact_csv")
  errorMessage       String?   @map("error_message")
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestedByUserId, createdAt])
  @@index([reportType, status])
  @@map("report_jobs")
  @@schema("ops")
}

model AdminNotification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId  String?   @map("recipient_user_id") @db.Uuid
  audience         String    @default("BROADCAST") @db.VarChar(20)
  audienceRole     String?   @map("audience_role") @db.VarChar(50)
  severity         String    @default("INFO") @db.VarChar(20)
  title            String    @db.VarChar(200)
  body             String
  linkPath         String?   @map("link_path") @db.VarChar(300)
  sourceModule     String    @default("platform") @map("source_module") @db.VarChar(50)
  dedupeKey        String?   @map("dedupe_key") @db.VarChar(120)
  readAt           DateTime? @map("read_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientUserId, createdAt])
  @@map("admin_notifications")
  @@schema("ops")
}

model AlertThreshold {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique @db.VarChar(80)
  displayName      String    @map("display_name") @db.VarChar(200)
  description      String?
  metricKey        String    @map("metric_key") @db.VarChar(80)
  warnAbove        Decimal?  @map("warn_above") @db.Decimal(12, 2)
  criticalAbove    Decimal?  @map("critical_above") @db.Decimal(12, 2)
  enabled          Boolean   @default(true)
  updatedByUserId  String?   @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("alert_thresholds")
  @@schema("ops")
}

model SystemSetting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(100)
  displayName     String   @map("display_name") @db.VarChar(200)
  description     String?
  valueText       String   @map("value_text")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([code])
  @@map("system_settings")
  @@schema("ops")
}

model FulfillmentCase {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                     String    @unique @map("order_id") @db.Uuid
  status                      String    @default("PENDING_HANDOFF") @db.VarChar(30)
  orchestrationStatus         String    @default("PLACED") @map("orchestration_status") @db.VarChar(40)
  assignedToUserId            String?   @map("assigned_to_user_id") @db.Uuid
  carrierCode                 String?   @map("carrier_code") @db.VarChar(50)
  trackingRef                 String?   @map("tracking_ref") @db.VarChar(100)
  pickupNotes                 String?   @map("pickup_notes")
  deliveryNotes               String?   @map("delivery_notes")
  exceptionCode               String?   @map("exception_code") @db.VarChar(50)
  exceptionNotes              String?   @map("exception_notes")
  readyAt                     DateTime? @map("ready_at") @db.Timestamptz
  shippedAt                   DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt                 DateTime? @map("delivered_at") @db.Timestamptz
  closedAt                    DateTime? @map("closed_at") @db.Timestamptz
  sellerAcceptedAt            DateTime? @map("seller_accepted_at") @db.Timestamptz
  preparingAt                 DateTime? @map("preparing_at") @db.Timestamptz
  readyForPickupAt            DateTime? @map("ready_for_pickup_at") @db.Timestamptz
  courierAssignedAt           DateTime? @map("courier_assigned_at") @db.Timestamptz
  pickedUpAt                  DateTime? @map("picked_up_at") @db.Timestamptz
  inTransitAt                 DateTime? @map("in_transit_at") @db.Timestamptz
  settledAt                   DateTime? @map("settled_at") @db.Timestamptz
  sellerPickupConfirmedAt     DateTime? @map("seller_pickup_confirmed_at") @db.Timestamptz
  courierPickupConfirmedAt    DateTime? @map("courier_pickup_confirmed_at") @db.Timestamptz
  buyerDeliveryConfirmedAt    DateTime? @map("buyer_delivery_confirmed_at") @db.Timestamptz
  courierDeliveryConfirmedAt  DateTime? @map("courier_delivery_confirmed_at") @db.Timestamptz
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  order            Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events           FulfillmentEvent[]
  shipments        Shipment[]

  @@index([status])
  @@index([orchestrationStatus])
  @@index([assignedToUserId])
  @@map("fulfillment_cases")
  @@schema("delivery")
}

model FulfillmentEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fulfillmentId String   @map("fulfillment_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(40)
  fromStatus    String?  @map("from_status") @db.VarChar(30)
  toStatus      String?  @map("to_status") @db.VarChar(30)
  message       String?
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  metadataJson  Json?    @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  fulfillment   FulfillmentCase @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
  @@map("fulfillment_events")
  @@schema("delivery")
}

model CourierProfile {
  userId                       String    @id @map("user_id") @db.Uuid
  displayName                  String?   @map("display_name") @db.VarChar(200)
  phone                        String?   @db.VarChar(20)
  vehicleType                  String?   @map("vehicle_type") @db.VarChar(40)
  active                       Boolean   @default(true)
  verified                     Boolean   @default(false)
  availability                 String    @default("OFFLINE") @db.VarChar(20)
  serviceRegions               String[]  @default([]) @map("service_regions")
  lastLat                      Float?    @map("last_lat")
  lastLng                      Float?    @map("last_lng")
  lastAccuracyM                Float?    @map("last_accuracy_m")
  locationAt                   DateTime? @map("location_at") @db.Timestamptz
  photoUrl                     String?   @map("photo_url")
  gender                       String?   @db.VarChar(20)
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  emergencyContactName         String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone        String?   @map("emergency_contact_phone") @db.VarChar(25)
  preferredLanguage            String    @default("en") @map("preferred_language") @db.Char(2)
  verificationStatus           String    @default("NOT_SUBMITTED") @map("verification_status") @db.VarChar(20)
  verificationRejectionReason  String?   @map("verification_rejection_reason")
  notificationPrefs            Json      @default("{}") @map("notification_prefs")
  activeVehicleId              String?   @map("active_vehicle_id") @db.Uuid
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt                    DateTime? @map("deleted_at") @db.Timestamptz

  @@index([availability])
  @@map("courier_profiles")
  @@schema("delivery")
}

model CourierVehicle {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId        String    @map("courier_user_id") @db.Uuid
  vehicleType          String    @map("vehicle_type") @db.VarChar(20)
  brand                String?   @db.VarChar(100)
  model                String?   @db.VarChar(100)
  year                 Int?
  colour               String?   @db.VarChar(60)
  plateNumber          String    @map("plate_number") @db.VarChar(40)
  registrationNumber   String?   @map("registration_number") @db.VarChar(80)
  insuranceExpiry      DateTime? @map("insurance_expiry") @db.Date
  photoUrl             String?   @map("photo_url")
  isActive             Boolean   @default(false) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  @@index([courierUserId])
  @@map("courier_vehicles")
  @@schema("delivery")
}

model CourierPayoutAccount {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId String    @map("courier_user_id") @db.Uuid
  methodType    String    @map("method_type") @db.VarChar(30)
  bankName      String?   @map("bank_name") @db.VarChar(120)
  accountName   String    @map("account_name") @db.VarChar(200)
  accountNumber String?   @map("account_number") @db.VarChar(80)
  phoneNumber   String?   @map("phone_number") @db.VarChar(25)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@index([courierUserId])
  @@map("courier_payout_accounts")
  @@schema("delivery")
}

model CourierVerificationCase {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courierUserId    String    @map("courier_user_id") @db.Uuid
  documentType     String    @map("document_type") @db.VarChar(30)
  documentNumber   String    @map("document_number") @db.VarChar(80)
  status           String    @default("PENDING") @db.VarChar(20)
  rejectionReason  String?   @map("rejection_reason")
  submittedAt      DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

