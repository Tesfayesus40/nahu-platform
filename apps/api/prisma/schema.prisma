  farmId          String      @map("farm_id") @db.Uuid
  farmerProfileId String?     @map("farmer_profile_id") @db.Uuid
  cooperativeId   String?     @map("cooperative_id") @db.Uuid
  partyRole       PartyRole   @map("party_role")
  tenureType      TenureType? @map("tenure_type")
  validFrom       DateTime?   @map("valid_from") @db.Date
  validTo         DateTime?   @map("valid_to") @db.Date
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  reason          String?     @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  farm            Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("farm_party_history")
  @@schema("farms")
}

model FarmAuditLog {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  FarmAuditEntityType @map("entity_type")
  entityId    String              @map("entity_id") @db.Uuid
  farmId      String              @map("farm_id") @db.Uuid
