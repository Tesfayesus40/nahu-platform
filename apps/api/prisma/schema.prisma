  @@index([entityType, entityId])
  @@map("farm_audit_log")
  @@schema("farms")
}

// ============================================================================
// Inventory module (Phase 4.2)
// Maps database/migrations/inventory/001..005 + catalog/009_unit_conversions
// ============================================================================

enum LotStatus {
  RECEIVED
  AVAILABLE
  RESERVED
  QUARANTINE
  DAMAGED
  EXPIRED
  SOLD
  DEPLETED
  CANCELLED

  @@schema("inventory")
  @@map("lot_status")
}

enum MovementType {
  RECEIVE
  ADJUST_IN
  ADJUST_OUT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE
  DISPATCH
  LOSS
  RETURN
  RELOCATE

  @@schema("inventory")
  @@map("movement_type")
}

enum LotSourceType {
  HARVEST
  PURCHASE
  TRANSFER_IN
  ADJUSTMENT_OPENING
  OTHER

  @@schema("inventory")
  @@map("lot_source_type")
}

model StockLot {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotCode          String        @map("lot_code") @db.VarChar(64)
  productId        String        @map("product_id") @db.Uuid
  productVarietyId String?       @map("product_variety_id") @db.Uuid
  farmId           String        @map("farm_id") @db.Uuid
  plotId           String?       @map("plot_id") @db.Uuid
  storageSiteId       String?       @map("storage_site_id") @db.Uuid
  storageLabel        String?       @map("storage_label") @db.VarChar(150)
  unitCode            String        @map("unit_code") @db.VarChar(20)
  quantityOnHand      Decimal       @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  quantityReserved    Decimal       @default(0) @map("quantity_reserved") @db.Decimal(14, 3)
  status              LotStatus     @default(AVAILABLE)
  sourceType          LotSourceType @default(HARVEST) @map("source_type")
  harvestDate         DateTime?     @map("harvest_date") @db.Date
  receivedAt          DateTime      @default(now()) @map("received_at") @db.Timestamptz
  expiresOn           DateTime?     @map("expires_on") @db.Date
  qualityNote         String?       @map("quality_note")
  externalRef         String?       @map("external_ref") @db.VarChar(100)
  croppingCycleId     String?       @map("cropping_cycle_id") @db.Uuid
  croppingCycleLineId String?       @map("cropping_cycle_line_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariety      ProductVariety?   @relation(fields: [productVarietyId], references: [id], onDelete: SetNull)
  farm                Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  plot                Plot?             @relation(fields: [plotId], references: [id], onDelete: SetNull)
  storageSite         StorageSite?      @relation(fields: [storageSiteId], references: [id], onDelete: SetNull)
  unit                Unit              @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  croppingCycle       CroppingCycle?    @relation(fields: [croppingCycleId], references: [id], onDelete: SetNull)
  croppingCycleLine   CroppingCycleLine? @relation(fields: [croppingCycleLineId], references: [id], onDelete: SetNull)
  movements           StockMovement[]
  reservations        Reservation[]
  listings            Listing[]
  harvestLines        HarvestLine[]

  @@unique([farmId, lotCode])
  @@index([farmId])
  @@index([productId])
  @@index([status])
  @@index([storageSiteId])
  @@index([croppingCycleId])
  @@index([croppingCycleLineId])
  @@map("stock_lots")
  @@schema("inventory")
}

model StockMovement {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId                 String       @map("lot_id") @db.Uuid
  movementType          MovementType @map("movement_type")
  qty                   Decimal      @db.Decimal(14, 3)
  unitCode              String       @map("unit_code") @db.VarChar(20)
  qtyInLotUnit          Decimal      @map("qty_in_lot_unit") @db.Decimal(14, 3)
  reason                String?      @db.VarChar(500)
  actorUserId           String?      @map("actor_user_id") @db.Uuid
  listingId             String?      @map("listing_id") @db.Uuid
  orderId               String?      @map("order_id") @db.Uuid
  counterpartMovementId String?      @map("counterpart_movement_id") @db.Uuid
  fromStorageSiteId     String?      @map("from_storage_site_id") @db.Uuid
  toStorageSiteId       String?      @map("to_storage_site_id") @db.Uuid
  metadata              Json?
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz

  lot                   StockLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  unit                  Unit          @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  counterpart           StockMovement? @relation("MovementCounterpart", fields: [counterpartMovementId], references: [id], onDelete: SetNull)
  counterparts          StockMovement[] @relation("MovementCounterpart")
  fromStorageSite       StorageSite?  @relation("MovementFromSite", fields: [fromStorageSiteId], references: [id], onDelete: SetNull)
  toStorageSite         StorageSite?  @relation("MovementToSite", fields: [toStorageSiteId], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@index([createdAt])
  @@map("stock_movements")
  @@schema("inventory")
}

// ============================================================================
// Warehouse module (Phase 4.3)
// Maps database/migrations/warehouse/001..005 + inventory/006
// ============================================================================

enum WarehouseSiteType {
  ON_FARM
  COOPERATIVE
  NAHU
  THIRD_PARTY

  @@schema("warehouse")
  @@map("site_type")
}

enum WarehouseSiteStatus {
  ACTIVE
  INACTIVE

  @@schema("warehouse")
  @@map("site_status")
}

enum WarehousePartyRole {
  OWNER
  MANAGER
  VIEWER

  @@schema("warehouse")
  @@map("party_role")
}

enum WarehousePartyStatus {
  ACTIVE
  INACTIVE

  @@schema("warehouse")
  @@map("party_status")
}

model StorageSite {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String?             @db.VarChar(40)
  name             String              @db.VarChar(150)
  nameAm           String?             @map("name_am") @db.VarChar(150)
  siteType         WarehouseSiteType   @map("site_type")
  status           WarehouseSiteStatus @default(ACTIVE)
  farmId           String?             @map("farm_id") @db.Uuid
  cooperativeId    String?             @map("cooperative_id") @db.Uuid
  region           String?             @db.VarChar(100)
  regionEn         String?             @map("region_en") @db.VarChar(100)
  zone             String?             @db.VarChar(100)
  woreda           String?             @db.VarChar(100)
  kebele           String?             @db.VarChar(100)
  centroidLat      Decimal?            @map("centroid_lat") @db.Decimal(10, 7)
  centroidLng      Decimal?            @map("centroid_lng") @db.Decimal(10, 7)
  capacity         Decimal?            @db.Decimal(14, 3)
  capacityUnitCode String?             @map("capacity_unit_code") @db.VarChar(20)
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  farm             Farm?               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  cooperative      Cooperative?        @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)
  capacityUnit     Unit?               @relation(fields: [capacityUnitCode], references: [code], onDelete: Restrict)
  parties          WarehouseParty[]
  zones            StorageZone[]
  stockLots        StockLot[]
  movementsFrom    StockMovement[]     @relation("MovementFromSite")
  movementsTo      StockMovement[]     @relation("MovementToSite")
  harvestLines     HarvestLine[]

  @@index([farmId])
  @@index([status])
  @@index([siteType])
  @@map("storage_sites")
  @@schema("warehouse")
}

model WarehouseParty {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageSiteId   String                @map("storage_site_id") @db.Uuid
  farmerProfileId String?               @map("farmer_profile_id") @db.Uuid
  cooperativeId   String?               @map("cooperative_id") @db.Uuid
  partyRole       WarehousePartyRole    @map("party_role")
  isPrimary       Boolean               @default(false) @map("is_primary")
  status          WarehousePartyStatus  @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @default(now()) @map("updated_at") @db.Timestamptz

  storageSite     StorageSite           @relation(fields: [storageSiteId], references: [id], onDelete: Cascade)
  farmerProfile   FarmerProfile?        @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  cooperative     Cooperative?          @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@index([storageSiteId])
  @@index([farmerProfileId])
  @@map("warehouse_parties")
  @@schema("warehouse")
}

model StorageZone {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageSiteId String              @map("storage_site_id") @db.Uuid
  code          String?             @db.VarChar(40)
  name          String              @db.VarChar(150)
  status        WarehouseSiteStatus @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz

  storageSite   StorageSite         @relation(fields: [storageSiteId], references: [id], onDelete: Cascade)

  @@index([storageSiteId])
  @@map("storage_zones")
  @@schema("warehouse")
}

enum ReservationStatus {
  ACTIVE
  ORDER_HELD
  RELEASED
  CONSUMED
  ALLOCATED
  DISPATCHED

  @@schema("inventory")
  @@map("reservation_status")
}

model Reservation {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId     String            @map("lot_id") @db.Uuid
  listingId String?           @map("listing_id") @db.Uuid
  orderId   String?           @map("order_id") @db.Uuid
  qty       Decimal           @db.Decimal(14, 3)
  unitCode  String            @map("unit_code") @db.VarChar(20)
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  lot       StockLot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  unit      Unit              @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  listing   Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@index([listingId])
  @@index([orderId])
  @@map("reservations")
  @@schema("inventory")
}

// ---------------------------------------------------------------------------
// Pricing / revenue engine
// ---------------------------------------------------------------------------

model FeeSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @db.VarChar(80)
  displayName   String    @map("display_name") @db.VarChar(200)
  version       Int       @default(1)
  isActive      Boolean   @default(false) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  platformFees         PlatformFee?
  deliveryTariffs      DeliveryTariff[]
  deliveryCommissions  DeliveryCommission?
  deliveryQuotes       DeliveryQuote[]

  @@unique([code, version])
  @@index([isActive])
  @@map("fee_schedules")
  @@schema("pricing")
}

model PlatformFee {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeScheduleId String   @unique @map("fee_schedule_id") @db.Uuid
  buyerFeePct   Decimal  @default(0) @map("buyer_fee_pct") @db.Decimal(8, 4)
  farmerFeePct  Decimal  @default(0) @map("farmer_fee_pct") @db.Decimal(8, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  feeSchedule   FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@map("platform_fees")
  @@schema("pricing")
}

model DeliveryTariff {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeScheduleId String   @map("fee_schedule_id") @db.Uuid
  vehicleType   String   @map("vehicle_type") @db.VarChar(40)
  baseFareEtb   Decimal  @default(0) @map("base_fare_etb") @db.Decimal(12, 2)
  perKmEtb      Decimal  @default(0) @map("per_km_etb") @db.Decimal(12, 4)
  perKgEtb      Decimal  @default(0) @map("per_kg_etb") @db.Decimal(12, 4)
  perM3Etb      Decimal  @default(0) @map("per_m3_etb") @db.Decimal(12, 4)
  minFareEtb    Decimal  @default(0) @map("min_fare_etb") @db.Decimal(12, 2)
  maxFareEtb    Decimal? @map("max_fare_etb") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  feeSchedule   FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@unique([feeScheduleId, vehicleType])
  @@index([feeScheduleId])
  @@map("delivery_tariffs")
  @@schema("pricing")
}

model DeliveryCommission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeScheduleId   String   @unique @map("fee_schedule_id") @db.Uuid
  commissionType  String   @default("PERCENT") @map("commission_type") @db.VarChar(20)
  commissionValue Decimal  @default(0) @map("commission_value") @db.Decimal(12, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  feeSchedule     FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@map("delivery_commissions")
  @@schema("pricing")
}

model DeliveryQuote {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeScheduleId          String    @map("fee_schedule_id") @db.Uuid
  buyerUserId            String?   @map("buyer_user_id") @db.Uuid
  vehicleType            String    @map("vehicle_type") @db.VarChar(40)
  distanceKm             Decimal   @default(0) @map("distance_km") @db.Decimal(12, 3)
  weightKg               Decimal   @default(0) @map("weight_kg") @db.Decimal(12, 3)
  volumeM3               Decimal   @default(0) @map("volume_m3") @db.Decimal(12, 4)
  deliveryFeeEtb         Decimal   @map("delivery_fee_etb") @db.Decimal(12, 2)
  deliveryCommissionEtb  Decimal   @default(0) @map("delivery_commission_etb") @db.Decimal(12, 2)
  courierPayoutEtb       Decimal   @default(0) @map("courier_payout_etb") @db.Decimal(12, 2)
  currency               String    @default("ETB") @db.VarChar(3)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz
  orderId                String?   @map("order_id") @db.Uuid
  metadataJson           Json?     @map("metadata_json")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  feeSchedule            FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)

  @@index([buyerUserId])
  @@index([expiresAt])
  @@index([orderId])
  @@map("delivery_quotes")
  @@schema("pricing")
}

model PaymentIntent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  providerCode      String   @map("provider_code") @db.VarChar(40)
  intentType        String   @map("intent_type") @db.VarChar(40)
  amountEtb         Decimal  @map("amount_etb") @db.Decimal(12, 2)
  currency          String   @default("ETB") @db.VarChar(3)
  status            String   @default("RECORDED_PENDING_PROVIDER") @db.VarChar(40)
  externalReference String?  @map("external_reference") @db.VarChar(120)
  metadataJson      Json?    @map("metadata_json")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([intentType, status])
  @@map("payment_intents")
  @@schema("pricing")
}

// ─── G9 Payment orchestration (payments schema) ─────────────────────────────

model PaymentCase {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String    @unique @map("order_id") @db.Uuid
  providerCode            String    @map("provider_code") @db.VarChar(40)
  paymentStatus           String    @default("CREATED") @map("payment_status") @db.VarChar(40)
  escrowStatus            String    @default("NONE") @map("escrow_status") @db.VarChar(40)
  settlementStatus        String    @default("NOT_STARTED") @map("settlement_status") @db.VarChar(40)
  refundStatus            String    @default("NONE") @map("refund_status") @db.VarChar(40)
  currency                String    @default("ETB") @db.VarChar(3)
  amountEtb               Decimal   @default(0) @map("amount_etb") @db.Decimal(12, 2)
  goodsSubtotalEtb        Decimal   @default(0) @map("goods_subtotal_etb") @db.Decimal(12, 2)
  buyerFeeEtb             Decimal   @default(0) @map("buyer_fee_etb") @db.Decimal(12, 2)
  farmerFeeEtb            Decimal   @default(0) @map("farmer_fee_etb") @db.Decimal(12, 2)
  farmerPayoutEtb         Decimal   @default(0) @map("farmer_payout_etb") @db.Decimal(12, 2)
  deliveryFeeEtb          Decimal   @default(0) @map("delivery_fee_etb") @db.Decimal(12, 2)
  deliveryCommissionEtb   Decimal   @default(0) @map("delivery_commission_etb") @db.Decimal(12, 2)
  courierPayoutEtb        Decimal   @default(0) @map("courier_payout_etb") @db.Decimal(12, 2)
  platformRevenueEtb      Decimal   @default(0) @map("platform_revenue_etb") @db.Decimal(12, 2)
  escrowHeldEtb           Decimal   @default(0) @map("escrow_held_etb") @db.Decimal(12, 2)
  escrowReleasedEtb       Decimal   @default(0) @map("escrow_released_etb") @db.Decimal(12, 2)
  escrowRefundedEtb       Decimal   @default(0) @map("escrow_refunded_etb") @db.Decimal(12, 2)
  externalReference       String?   @map("external_reference") @db.VarChar(120)
  pendingAt               DateTime? @map("pending_at") @db.Timestamptz
  authorizedAt            DateTime? @map("authorized_at") @db.Timestamptz
  capturedAt              DateTime? @map("captured_at") @db.Timestamptz
  escrowedAt              DateTime? @map("escrowed_at") @db.Timestamptz
  settledAt               DateTime? @map("settled_at") @db.Timestamptz
  refundedAt              DateTime? @map("refunded_at") @db.Timestamptz
  failedAt                DateTime? @map("failed_at") @db.Timestamptz
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz
  failureReason           String?   @map("failure_reason")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  order                   Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events                  PaymentEvent[]
  escrowLedger            EscrowLedger[]
  settlementLines         SettlementLine[]

  @@index([paymentStatus])
  @@index([providerCode])
  @@map("payment_cases")
  @@schema("payments")
}

model PaymentEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentCaseId String   @map("payment_case_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(60)
  fromStatus    String?  @map("from_status") @db.VarChar(40)
  toStatus      String?  @map("to_status") @db.VarChar(40)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  reason        String?
  message       String?
  metadataJson  Json?    @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  paymentCase   PaymentCase @relation(fields: [paymentCaseId], references: [id], onDelete: Cascade)

  @@index([paymentCaseId])
  @@map("payment_events")
  @@schema("payments")
}

model EscrowLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentCaseId String   @map("payment_case_id") @db.Uuid
  entryType     String   @map("entry_type") @db.VarChar(40)
  amountEtb     Decimal  @map("amount_etb") @db.Decimal(12, 2)
  partyCode     String?  @map("party_code") @db.VarChar(40)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  reason        String?
  metadataJson  Json?    @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  paymentCase   PaymentCase @relation(fields: [paymentCaseId], references: [id], onDelete: Cascade)

  @@index([paymentCaseId])
  @@map("escrow_ledger")
  @@schema("payments")
}

model SettlementLine {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentCaseId String    @map("payment_case_id") @db.Uuid
  partyCode     String    @map("party_code") @db.VarChar(40)
  amountEtb     Decimal   @map("amount_etb") @db.Decimal(12, 2)
  status        String    @default("PENDING") @db.VarChar(40)
  intentId      String?   @map("intent_id") @db.Uuid
  releasedAt    DateTime? @map("released_at") @db.Timestamptz
  metadataJson  Json?     @map("metadata_json")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  paymentCase   PaymentCase @relation(fields: [paymentCaseId], references: [id], onDelete: Cascade)

